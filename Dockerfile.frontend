# syntax=docker/dockerfile:1
# Standalone MJ Assistant Frontend Container (Static Vite SPA via Nginx)
# Receives ONLY the public VITE_API_BASE_URL build arg — zero API secrets ever enter this image.

FROM node:24-slim AS builder

WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/server/package.json ./apps/server/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/desktop/package.json ./apps/desktop/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/ai/package.json ./packages/ai/package.json
COPY packages/voice/package.json ./packages/voice/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY database/package.json ./database/package.json

RUN npm ci --ignore-scripts

COPY packages/shared ./packages/shared
COPY packages/voice ./packages/voice
COPY packages/ui ./packages/ui
COPY apps/web ./apps/web

# Public backend origin baked into Vite bundle at build time (e.g. https://api.mj.yourdomain.com)
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run typecheck --workspace=@mj/web \
 && npm run build --workspace=@mj/web \
 && ! grep -E "AUTH_SECRET|APP_ACCESS_PASSCODE|xai-[A-Za-z0-9]{12,}" /app/apps/web/dist/assets/*.js

FROM nginx:1.27-alpine

ARG VITE_API_BASE_URL=""
COPY deploy/nginx.frontend.conf /etc/nginx/conf.d/default.conf
RUN API_ORIGIN=$(printf '%s' "$VITE_API_BASE_URL" | sed -nE 's#^(https?://[^/]+).*#\1#p') \
 && if [ -n "$API_ORIGIN" ]; then sed -i "s#https://api.yourdomain.com#${API_ORIGIN}#g" /etc/nginx/conf.d/default.conf; fi
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O - http://127.0.0.1:80/healthz >/dev/null 2>&1 || exit 1
