# ==============================================================================
# MJ AI Desktop Assistant — Environment & API Template
# Copy this file to .env and configure your keys:
# cp .env.example .env
# ==============================================================================

# Primary Google Gemini API Key (Required for voice & multimodal AI)
# Get a free key at: https://aistudio.google.com/apikey (starts with AIzaSy...)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Assistant Identity & User Settings
ASSISTANT_NAME=MJ
USER_NAME=YourName
MORNING_BRIEF_ENABLED=true
UI_COLOR=#00C2FF

# Real-Time Voice & Hardware Tuning
FOLLOWUP_LISTEN_SECONDS=7.0
BARGE_IN_RMS_THRESHOLD=1400.0

# Optional Local LLM Provider ("ollama" or "openai" / LM Studio)
LLM_PROVIDER=ollama
LLM_URL=http://localhost:11434
LLM_MODEL=llama3.2
OPENAI_API_KEY=

# Optional Weather / Custom APIs
OPENWEATHER_API_KEY=

# Picovoice Porcupine Wake Word Engine (Optional)
# Sign up at: https://console.picovoice.ai/signup
PICOVOICE_ACCESS_KEY=

# ElevenLabs Cloud TTS (Optional - for high fidelity cloud voices)
ELEVENLABS_API_KEY=

# Smart Home Integration (Optional)
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
IFTTT_WEBHOOK_KEY=

# Web Dashboard & Remote Access Configuration
DASHBOARD_PIN=123456
PORT=8000
HOST=0.0.0.0
