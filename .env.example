# ==============================================================================
# MJ Assistant — Stage 1 Environment Configuration (Placeholders Only)
# Copy this file to `.env` and fill in your real values before running.
# NEVER commit `.env` or expose `XAI_API_KEY` or `AUTH_SECRET` to the browser.
# ==============================================================================

# --- Core xAI Configuration (Server-Side Only) ---
# Generate an API key at https://console.x.ai
XAI_API_KEY=your_xai_api_key_here

# Re-verify current supported Grok reasoning models at https://docs.x.ai
XAI_TEXT_MODEL=grok-4.7

# Reserved for Stage 2 (Voice Engine — unused in Stage 1 Text MVP)
XAI_VOICE_MODEL=grok-voice-latest

# Optional: xAI API Base URL (defaults to https://api.x.ai/v1)
XAI_BASE_URL=https://api.x.ai/v1

# --- Application & Security ---
# Allowed values: development | test | production
APP_ENV=development

# Cryptographic secret used to sign HttpOnly session cookies (min 32 chars)
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_a_long_random_secret_min_32_chars

# Optional local/hosted access passcode.
# Required when APP_ENV=production. In development, leave blank for local
# single-user session bootstrap or set a passcode to enable lock-screen login.
APP_ACCESS_PASSCODE=

# --- Persistence (Local-First SQLite) ---
DATABASE_URL=./data/mj-assistant.db

# --- Server & CORS ---
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:5173

# --- Optional AI Runtime Defaults ---
XAI_TIMEOUT_MS=60000
XAI_MAX_OUTPUT_TOKENS=4096
XAI_REASONING_EFFORT=medium
