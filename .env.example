# ==============================================================================
# MJ Assistant — Environment Configuration (Placeholders Only)
# Copy this file to `.env` and fill in your real values before running.
# NEVER commit `.env` or expose API keys or `AUTH_SECRET` to the browser.
# ==============================================================================

# --- Primary AI & Voice Provider: Google Gemini (Server-Side Only) ---
# Strict Free-Only Mode defaults to true: blocks all paid API calls (xAI, OpenRouter, or paid tiers) even on failover.
# Active 100% Free Chain: Gemini Free Tier (gemini-2.5-flash / gemini-2.5-flash-lite) -> Ollama (local) -> Groq Free Tier (llama-3.3-70b-versatile).
FREE_ONLY_MODE=true
AI_PROVIDER=auto
# Optional display name so MJ can address you naturally in chat and voice
# USER_NAME=

# Generate a free Google Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
VOICE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Set GEMINI_PAID_TIER=true only if using paid Google Cloud billing (free tier is never blocked by budget caps)
# GEMINI_PAID_TIER=false

# --- Optional Server-Side Tool Keys (Never Exposed to Browser) ---
# OPENWEATHER_API_KEY=your_openweather_api_key_here
# WEB_SEARCH_API_KEY=your_web_search_api_key_here

# --- Zero-Cost & Local Fallback Providers ---
# 1) Ollama Local (100% Free, Zero API Key — auto-enabled in local dev if running on 127.0.0.1:11434)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# 2) Groq Free Developer Tier (Fast LLM Chat + Free Whisper STT fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 3) OpenRouter Free Models (:free)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=openrouter/free

# 4) Cerebras Free Developer Tier
# CEREBRAS_API_KEY=your_cerebras_api_key_here
# CEREBRAS_MODEL=llama-3.3-70b

# 5) Mistral AI Free / Experiment Tier
# MISTRAL_API_KEY=your_mistral_api_key_here
# MISTRAL_MODEL=mistral-small-latest

# 6) GitHub Models (Free rate-limited inference via GitHub PAT)
# GITHUB_MODELS_TOKEN=your_github_pat_here
# GITHUB_MODELS_MODEL=gpt-4o-mini

# --- Optional Paid Fallback: xAI Grok (Console Billing Required) ---
# Only used if FREE_ONLY_MODE=false & configured with credits; skipped cleanly in FREE_ONLY_MODE.
XAI_API_KEY=your_xai_api_key_here
XAI_TEXT_MODEL=grok-4.7
# XAI_AVAILABLE_MODELS=grok-4.7,grok-4-1-fast
# XAI_VOICE_MODEL=grok-voice-latest
XAI_BASE_URL=https://api.x.ai/v1

# --- Application & Security ---
# Allowed values: development | test | production
APP_ENV=development

# Cryptographic secret used to sign HttpOnly session cookies (min 32 chars, required in production)
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_a_long_random_secret_min_32_chars

# Access passcode for Unlock Gate.
# Required (min 8 chars) when APP_ENV=production; optional in development.
APP_ACCESS_PASSCODE=

# --- Persistence (Single Local-First SQLite Resolved From Project Root) ---
DATABASE_URL=./data/mj-assistant.db

# --- Server, Static Hosting & CORS ---
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Serve built apps/web/dist from the Fastify server (defaults to true in production, false in dev)
SERVE_WEB_DIST=false

# --- Optional AI Runtime Defaults ---
XAI_TIMEOUT_MS=60000
XAI_MAX_OUTPUT_TOKENS=4096
XAI_REASONING_EFFORT=medium

# Cross-domain split deployment cookie settings (optional; set COOKIE_SAME_SITE=none with HTTPS when frontend and backend use different origins)
# COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=

# --- Uptime Watchdog, Crash & Error-Rate Alerting (Optional; all placeholders ignored) ---
# Includes background 60s health watchdog + SQLite-persisted error window & alert cooldown.
# Telegram Bot alerts (configure both to enable)
# ALERT_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# ALERT_TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Email alerts via Resend HTTPS API or SMTP (never logged or exposed to browser)
# ALERT_RESEND_API_KEY=your_resend_api_key_here
# ALERT_SMTP_HOST=
# ALERT_SMTP_PORT=587
# ALERT_SMTP_SECURE=false
# ALERT_SMTP_USER=
# ALERT_SMTP_PASS=your_smtp_password_here
# ALERT_EMAIL_FROM=alerts@yourdomain.com
# ALERT_EMAIL_TO=ops@yourdomain.com
# ALERT_ERROR_RATE_PCT=25
# ALERT_MIN_REQUESTS=5
# ALERT_WINDOW_MINUTES=15
# ALERT_COOLDOWN_MINUTES=15

# --- Encrypted Automatic Daily Database Backup (Memory, Conversations & Settings) ---
# Dedicated key required (>= 16 chars, distinct from AUTH_SECRET — AUTH_SECRET fallback is disabled).
# See RESTORE.md for full recovery instructions (`npm run db:backup` / `npm run db:restore`).
# BACKUP_ENABLED=true
# BACKUP_ENCRYPTION_KEY=replace_with_strong_backup_passphrase_min_16_chars
# BACKUP_DIR=./data/backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_COUNT=14
