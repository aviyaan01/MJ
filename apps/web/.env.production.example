# MJ Assistant — Production Frontend Environment Template
# Copy to apps/web/.env.production (or configure in Vercel/Cloudflare Pages/Docker build args).
#
# SECURITY WARNING:
# Vite embeds every VITE_* variable directly into the static JavaScript bundle!
# NEVER put XAI_API_KEY, AUTH_SECRET, APP_ACCESS_PASSCODE, or any secret here.
# All xAI API calls and ephemeral realtime voice token minting stay on the backend.

VITE_API_BASE_URL=https://api.yourdomain.com
