# MJ Assistant — Production Backend Environment Template
# Copy to apps/server/.env.production (for docker-compose.prod.yml) or configure in your backend host's secret manager.
# All values below are placeholders only — NEVER commit real secrets to Git or expose them to the frontend.

# Runtime & HTTP binding
APP_ENV=production
HOST=0.0.0.0
PORT=3001
SERVE_WEB_DIST=false

# Exact HTTPS origin(s) of the separately deployed Frontend (comma-separated, no trailing slash)
CORS_ORIGIN=https://app.yourdomain.com

# Session Cookie configuration for separate Backend + Frontend origins
# Set COOKIE_SAME_SITE=none over HTTPS when Frontend and Backend run on different origins.
# If both share the same root domain (e.g. app.yourdomain.com + api.yourdomain.com), you may use lax or none
# and optionally set COOKIE_DOMAIN=.yourdomain.com. Setting none forces Secure cookies automatically.
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=

# SQLite persistence (Docker mounts a persistent volume at /app/data)
DATABASE_URL=/app/data/mj-assistant.db

# Required Authentication Secrets (refused on startup in production if empty or placeholder)
# Generate AUTH_SECRET with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace_with_a_long_random_secret_min_32_chars
APP_ACCESS_PASSCODE=replace_with_strong_passcode_min_8_chars

# xAI Grok API (server-side ONLY — never shipped to browser; realtime voice uses short-lived ephemeral tokens)
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_TEXT_MODEL=grok-4.7
XAI_AVAILABLE_MODELS=grok-4.7,grok-4.6,grok-4.5,grok-4-1-fast,grok-3
XAI_VOICE_MODEL=grok-voice-latest
XAI_REASONING_EFFORT=medium
XAI_TIMEOUT_MS=60000
XAI_MAX_OUTPUT_TOKENS=4096
