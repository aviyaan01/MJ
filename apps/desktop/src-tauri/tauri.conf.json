{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MJ Assistant",
  "version": "0.1.0",
  "identifier": "com.mjassistant.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace=@mj/web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build --workspace=@mj/web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MJ Assistant",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "theme": "Dark",
        "backgroundColor": "#07080B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:3001 http://localhost:3001 wss://api.x.ai https://api.x.ai; media-src 'self' blob:; object-src 'none'; frame-ancestors 'none';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
